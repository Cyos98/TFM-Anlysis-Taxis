  create view "tfm_mobility"."gold"."mart_congestion_proxy__dbt_tmp"
    
    
  as (
    select
    hourly.zone_hour_service_key,
    hourly.date_key,
    hourly.hour_key,
    hourly.taxi_zone_key,
    zone.borough,
